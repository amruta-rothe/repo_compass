# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_BASE_URL=http://localhost:8501
APP_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── GitHub ───────────────────────────────────────────────────────────────────
# Optional but recommended. Without it you get 60 req/hr (unauthenticated).
# Create at: https://github.com/settings/tokens  (no scopes needed for public repos)
# Inside https://app.supabase.com -> Project Settings -> Authentication, find Github and copy the redirect URL and add it in the tokens. 
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# After creating of client_id and client_secret, add these into the supabase to enable connecting it with github.
# ─── Ollama / AI ──────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=your_actual_api_key_here

# qwen3:4b is a thinking-only model in Ollama: it ignores `think: false` and is both
# slow and unreliable for structured JSON. qwen3:4b-instruct is the non-thinking variant.
OLLAMA_MODEL=qwen3:4b-instruct
# Send `think: false` on every request (safe for non-thinking models).
OLLAMA_DISABLE_THINKING=true
# Keep the model warm between calls (e.g. 30m, 2h). Avoids cold model reload costs.
OLLAMA_KEEP_ALIVE=30m
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=2

# ─── Repository ingestion limits ─────────────────────────────────────────────
MAX_REPOSITORY_FILES=500
MAX_SOURCE_FILE_BYTES=250000
MAX_CONTEXT_CHARS=30000

# ─── Isolated runner (disabled for MVP) ──────────────────────────────────────
RUNNER_ENABLED=false
RUNNER_BASE_URL=
RUNNER_API_KEY=
RUNNER_TIMEOUT_SECONDS=30
